{
  "model_family": "gpt",
  "included_families": [
    "baseline",
    "ring",
    "recursive doubling",
    "hierarchical"
  ],
  "excluded": [
    "Direct",
    "k-ring",
    "DDP diagnostics",
    "MPI Hierarchical rates other than8",
    "Other"
  ],
  "systems": [
    "polaris"
  ],
  "argv": [
    "experiments_polaris",
    "--system",
    "polaris",
    "--backend",
    "mpi",
    "--mode",
    "strong",
