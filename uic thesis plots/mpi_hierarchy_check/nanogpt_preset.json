    "all",
    "--metrics",
    "time",
    "--layouts",
    "lines",
    "--output-root",
    "uic thesis plots/mpi_hierarchy_check"
  ],
  "manifests": [
    "uic thesis plots/mpi_hierarchy_check/polaris/manifest.json"
  ]
}